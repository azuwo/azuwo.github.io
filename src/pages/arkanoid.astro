---
import ArkanoidGame from '../components/Arkanoid.astro';
import Layout from '../layouts/Layout.astro';
---

<Layout title="Arkanoid - Juego Clásico">
  <main>
    <h1>Arkanoid</h1>
    <p class="instructions">
      Usa las flechas del teclado o los botones en pantalla para mover la paleta.
      <br />
      <span class="text-gradient">¡Rompe todos los bloques para ganar!</span>
    </p>
    
    <div class="game-container">
      <ArkanoidGame />
    </div>
  </main>
</Layout>

<style>
  main {
    margin: auto;
    padding: 1rem;
    max-width: 800px;
    color: var(--white);
    font-size: 20px;
    line-height: 1.6;
  }
  
  h1 {
    font-size: 4rem;
    font-weight: 700;
    line-height: 1;
    text-align: center;
    margin-bottom: 1em;
  }
  
  .text-gradient {
    background-image: linear-gradient(45deg, var(--green), var(--violet));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-size: 400%;
    background-position: 0%;
  }
  
  .instructions {
    margin-bottom: 2rem;
    border: 1px solid var(--gray);
    background: linear-gradient(rgba(9, 9, 11, 0.8), rgba(9, 9, 11, 0.6));
    padding: 1.5rem;
    border-radius: 8px;
    text-align: center;
  }
  
  .game-container {
    display: flex;
    justify-content: center;
    margin: 2rem 0;
  }
</style> 