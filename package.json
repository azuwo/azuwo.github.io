{
  "name": "astrodev",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "bun --bun astro dev",
    "start": "bun --bun astro dev",
    "build": "bun --bun astro build",
    "preview": "bun --bun astro preview",
    "astro": "bun --bun astro",
    "format": "bun --bun biome format --write .",
    "lint": "bun --bun biome lint .",
    "check": "bun --bun biome check --apply-unsafe .",
    "lint:fix": "bun --bun biome check --apply-unsafe --formatter-enabled=true --linter-enabled=true .",
    "test": "bun --bun vitest run",
    "test:watch": "bun --bun vitest",
    "test:coverage": "bun --bun vitest run --coverage"
  },
  "dependencies": {
    "astro": "^5.3.0",
    "astro-lazy-youtube-embed": "^0.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@testing-library/dom": "^10.4.0",
    "happy-dom": "^17.4.4",
    "jsdom": "^26.0.0",
    "vitest": "^3.0.8"
  },
  "packageManager": "pnpm@9.9.0+sha512.60c18acd138bff695d339be6ad13f7e936eea6745660d4cc4a776d5247c540d0edee1a563695c183a66eb917ef88f2b4feb1fc25f32a7adcadc7aaf3438e99c1"
}
